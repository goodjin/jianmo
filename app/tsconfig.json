{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["renderer/*"],
      "@types/*": ["../src/types/*"],
      "@wv/*": ["../webview/src/*"],
      "@core/*": ["../src/core/*"]
    }
  },
  "include": ["renderer/**/*.ts", "renderer/**/*.vue", "electron/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
