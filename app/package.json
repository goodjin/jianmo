{
  "name": "markly-app",
  "version": "0.8.20",
  "private": true,
  "description": "Markly 独立桌面文档查看与编辑器（Markdown / JSON / 文本，脱离 VSCode）",
  "author": "Markly <hi@agentlab.fun>",
  "homepage": "https://agentlab.fun/",
  "main": "dist/app/electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts --bundle --outfile=dist/app/electron/main.cjs --platform=node --format=cjs --external:electron --external:electron-store --external:mermaid --alias:katex=./node_modules/katex --alias:marked=./node_modules/marked && esbuild electron/preload.ts --bundle --outfile=dist/app/electron/preload.cjs --platform=node --format=cjs --external:electron",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "electron-store": "^8.2.0",
    "katex": "^0.16.9",
    "marked": "^12.0.2",
    "mermaid": "^11.14.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.19.8",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.19.12": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "fun.agentlab.markly",
    "productName": "Markly",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/app/**/*",
      "fonts/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "asar": true,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.text-editor",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 Markly",
        "NSDocumentsFolderUsageDescription": "Markly 需要读取「文稿」文件夹，以便打开和预览其中的文档。",
        "NSDesktopFolderUsageDescription": "Markly 需要读取「桌面」文件夹，以便打开和预览其中的文档。",
        "NSDownloadsFolderUsageDescription": "Markly 需要读取「下载」文件夹，以便打开和预览其中的文档。"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx",
          "mkd",
          "mkdn",
          "mdown",
          "mdwn"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": [
          "adoc",
          "asc",
          "asciidoc",
          "ass",
          "cfg",
          "conf",
          "config",
          "csr",
          "desktop",
          "diff",
          "dockerignore",
          "editorconfig",
          "env",
          "gitattributes",
          "gitignore",
          "ini",
          "key",
          "nfo",
          "npmrc",
          "nvmrc",
          "org",
          "patch",
          "pem",
          "po",
          "pot",
          "properties",
          "pub",
          "rst",
          "service",
          "srt",
          "ssa",
          "sub",
          "textile",
          "toml",
          "vtt",
          "yaml",
          "yml"
        ],
        "name": "Unclaimed Text",
        "description": "Text file without a usual application",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "bash",
          "bib",
          "c",
          "cc",
          "cjs",
          "cmake",
          "cpp",
          "cs",
          "css",
          "csv",
          "dart",
          "fish",
          "geojson",
          "go",
          "gradle",
          "h",
          "hh",
          "hpp",
          "htm",
          "html",
          "ics",
          "java",
          "js",
          "json",
          "json5",
          "jsonc",
          "jsonl",
          "jsx",
          "kt",
          "kts",
          "latex",
          "less",
          "log",
          "lua",
          "mjs",
          "mk",
          "ndjson",
          "php",
          "pl",
          "plist",
          "pm",
          "py",
          "r",
          "rb",
          "rs",
          "sass",
          "scala",
          "scss",
          "sh",
          "sql",
          "strings",
          "sty",
          "svelte",
          "svg",
          "swift",
          "tex",
          "text",
          "ts",
          "tsv",
          "tsx",
          "txt",
          "vcf",
          "vue",
          "xhtml",
          "xml",
          "zsh"
        ],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
