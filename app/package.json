{
  "name": "markly-app",
  "version": "0.4.1",
  "private": true,
  "description": "Markly 独立桌面 Markdown 查看编辑器（脱离 VSCode）",
  "author": "Markly <hi@agentlab.fun>",
  "homepage": "https://agentlab.fun/",
  "main": "dist/app/electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts --bundle --outfile=dist/app/electron/main.cjs --platform=node --format=cjs --external:electron --external:electron-store --external:mermaid --alias:katex=./node_modules/katex --alias:marked=./node_modules/marked && esbuild electron/preload.ts --bundle --outfile=dist/app/electron/preload.cjs --platform=node --format=cjs --external:electron",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "katex": "^0.16.9",
    "marked": "^12.0.2",
    "mermaid": "^11.14.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.19.8",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.19.12": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "fun.agentlab.markly",
    "productName": "Markly",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/app/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "asar": true,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.text-editor",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 Markly"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "rank": "Owner"
      }
    ]
  }
}
